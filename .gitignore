scripts/ux-verify.mjs

# Local config / generated artifacts left untracked
.claudeignore
ios/App/App.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# Python (solver in gcf/)
__pycache__/
*.pyc
*.pyo

# One-off production backfill backups (never committed)
.backfill-backups/

# scripts/normalize-instrument-names.mjs pre-mutation backup dump (never committed)
.normalize-instrument-backups/

# Isolated-dataset verification fixture backups (never committed)
.sr-verification-backups/

# Service Readiness A3 deployed-route Playwright harness output.
# NEVER committed: traces, videos, HTML reports and the run evidence/state files are
# per-run artifacts, and a Playwright `storageState` would be a live session
# credential for the verification administrator.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
*storageState*.json
# scripts/dev-verify.ts — the Verificador member's live session. Same rule as above.
/playwright/.dev-verify-storageState.json


# Local email template previews (scripts/preview-emails.mts)
.preview-emails/

# Agent worktrees. `EnterWorktree` checks out full copies of this repository
# here, so each one contains a `.git` FILE — and `git add -A` against a directory
# like that can stage it as a gitlink, committing a submodule-shaped reference to
# a path that exists on exactly one machine. Until now the only thing preventing
# that was `.git/info/exclude`, which is per-clone and shared with nobody.
# `.claude/commands/` stays tracked; only the worktrees are ignored.
.claude/worktrees/
